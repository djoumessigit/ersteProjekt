{
  "name": "maa-bri",
  "productName": "MA'A-Bri",
  "version": "1.0.0",
  "description": "MA'A-Bri - application Electron de gestion de stock d'epices (architecture en classes)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "author": "Saida Djuffo Djoumessi",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maabri.app",
    "productName": "MA'A-Bri",
    "compression": "normal",
    "icon": "src/renderer/assets/icon.png",
    "files": [
      "**/*",
      "!release/**",
      "!**/*.md",
      "!.git/**",
      "!node_modules/.cache/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "src/renderer/assets"
    },
    "win": {
      "target": ["nsis"],
      "icon": "src/renderer/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "src/renderer/assets/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "src/renderer/assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MA'A-Bri",
      "installerIcon": "src/renderer/assets/icon.ico",
      "uninstallerIcon": "src/renderer/assets/icon.ico",
      "installerHeaderIcon": "src/renderer/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}