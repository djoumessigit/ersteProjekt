{
  "name": "maa-bri",
  "productName": "MA'A-Bri",
  "version": "1.0.0",
  "description": "MA'A-Bri - application Electron de gestion de stock d'epices (architecture en classes)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maabri.app",
    "productName": "MA'A-Bri",
    "files": [
      "**/*",
      "!release/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VOTRE_UTILISATEUR_GITHUB",
        "repo": "VOTRE_DEPOT_GITHUB"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "src/renderer/assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "src/renderer/assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "src/renderer/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
